#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "English"
require "digest"
require "json"
require "time"

ROOT = File.expand_path("..", __dir__)
DENYLIST_PATH = File.join(ROOT, ".private/anonymization-denylist.txt")
DEFAULT_REPORT_DIR = File.join(Dir.home, ".cache", "autoresearch-genealogy", "privacy-audits")
REPORT_DIR = ENV.fetch("PRIVACY_AUDIT_REPORT_DIR", DEFAULT_REPORT_DIR)
EXCLUDED_PATHS = ["LICENSE"].freeze

# Every string this script handles is UTF-8, regardless of the caller's locale.
#
# Ruby derives Encoding.default_external from LANG/LC_ALL. With those UNSET it is
# US-ASCII, and then a denylist term containing a non-ASCII byte is tagged
# US-ASCII-but-invalid. That used to blow up inside Shellwords.shellescape
# ("invalid byte sequence in US-ASCII") and would equally break a regex match of
# such a term against UTF-8 repo content (Encoding::CompatibilityError).
#
# This is NOT an exotic edge case: an unset LANG is the NORMAL condition under
# cron, git hooks and CI — exactly the unattended contexts where a PII gate is
# the only thing looking. Pinning it here rather than asking callers to export a
# locale is the difference between a gate that works and a gate that works on
# someone's laptop.
def read_text(path)
  File.read(path, encoding: "UTF-8").scrub
end

def run_git(*args)
  # ARRAY form: argv is handed to execve directly, so there is no shell to quote
  # for, no Shellwords involved, and no metacharacter surface from a denylist
  # term — which is private, operator-supplied data being passed as `-S<term>`.
  # The old form built one string with shelljoin and ran it in backticks; that
  # is where the crash lived, and it is also the injection-prone shape.
  output = IO.popen(["git", "-C", ROOT, *args], "r", err: %i[child out], &:read)
  [output.to_s.force_encoding(Encoding::UTF_8).scrub, $CHILD_STATUS.exitstatus]
end

def tracked_text_files
  output, status = run_git("ls-files")
  abort "git ls-files failed:\n#{output}" unless status.zero?

  output.lines.map(&:strip).select do |path|
    full_path = File.join(ROOT, path)
    File.file?(full_path) && !File.binread(full_path, 1024).include?("\x00")
  end
end

def load_terms
  unless File.exist?(DENYLIST_PATH)
    abort "Missing #{DENYLIST_PATH}. Create it with one private term per line."
  end

  terms = read_text(DENYLIST_PATH).lines.map { |l| l.chomp }.map(&:strip).reject do |line|
    line.empty? || line.start_with?("#")
  end
  abort "No denylist terms found in #{DENYLIST_PATH}" if terms.empty?
  terms
end

def term_label(term)
  "sha256:#{Digest::SHA256.hexdigest(term)[0, 12]} len:#{term.length}"
end

def current_head_findings(terms)
  findings = []
  tracked_text_files.each do |path|
    next if EXCLUDED_PATHS.include?(path)

    text = read_text(File.join(ROOT, path))
    terms.each do |term|
      next unless text.include?(term)

      line_numbers = text.lines.each_with_index.map do |line, index|
        index + 1 if line.include?(term)
      end.compact
      findings << {
        term_label: term_label(term),
        path: path,
        lines: line_numbers
      }
    end
  end
  findings
end

def history_findings(terms)
  findings = []
  terms.each do |term|
    output, status = run_git("log", "--all", "--format=%H %s", "-S#{term}", "--", ".", ":(exclude)LICENSE")
    unless [0, 1].include?(status)
        findings << { term_label: term_label(term), error: "git log failed: #{output.strip}" }
      next
    end

    commits = output.lines.map(&:strip).reject(&:empty?)
    findings << { term_label: term_label(term), commits: commits } unless commits.empty?
  end
  findings
end

# --------------------------------------------------------------------------
# IDENTIFIER SCAN — a second class of disclosure the denylist cannot see.
#
# The denylist holds NAMES. An external record identifier is a POINTER to a
# name: paste a FamilySearch PID into familysearch.org and you get the person.
# So a code comment illustrating "strip PID-like tokens" with a REAL pid
# discloses an ancestor as surely as writing their name would, and passes a
# name-based audit clean. That happened here: four real identifiers sat in code
# comments as illustrations through three clean audit runs (22 JUL 2026), caught
# by a manual pre-push review rather than by this script.
#
# It happened once more while this very check was being written: the paragraph
# above originally quoted one of those identifiers verbatim, and the check's
# first run flagged its own explanation. Illustrate this rule with placeholders.
#
# Detected: the FamilySearch PID shape, four alphanumerics + hyphen + three.
# Measured over the tracked tree before shipping this: every occurrence was a
# placeholder, so the check starts at zero findings and any hit is real.
#
# NOT detected, deliberately: the WikiTree shape (Surname-Number). It is
# structurally identical to ordinary prose in these documents -- "Pre-1800",
# "Post-1906", "Phase-1", "Gen-2" all match it, and they outnumber real ids in
# the tracked tree by more than ten to one. A check that fires on prose is worse
# than no check, because it trains you to ignore it. That gap is real and known:
# a WikiTree id DID slip through the same manual review that caught the PIDs.
#
# HEAD ONLY, on purpose. History is not scanned for this class because the
# pre-scrub commits legitimately contain these identifiers and always will --
# rewriting published history to remove a public record pointer would be a much
# larger harm than the disclosure. The point of this check is to stop the NEXT
# one, not to relitigate what shipped.
IDENTIFIER_RE = /\b[A-Z0-9]{4}-[A-Z0-9]{3}\b/.freeze

# The WikiTree shape, ADDED 23 JUL 2026 — reversing the "deliberately not
# detected" decision above, because the reason for it was measurable and has
# been measured.
#
# The objection was correct: a bare /[A-Z][a-z]+-\d+/ matches ordinary prose in
# these documents — "Pre-1800", "Post-1906", "Phase-1", "Gen-2", "Spec-03" — and
# a check that fires on prose trains you to ignore it. But those false positives
# all share one property: the part before the hyphen is a STRUCTURAL WORD, not a
# surname. Allowlisting that closed vocabulary was measured over the whole
# tracked tree on 23 JUL 2026: 38 raw occurrences -> 21 prose tokens excluded ->
# 2 remaining, BOTH placeholders ("Generation-1" in a test, "Surname-48" in the
# PID-stripping docs). So the check starts at ZERO findings, which is the same
# bar the FS PID check was held to, and any hit is real.
#
# This gap was not hypothetical: a real WikiTree id (a 15th-century ancestor's)
# reached the published history through the manual review that caught the PIDs.
# HEAD is clean; this stops the next one.
WIKITREE_RE = /\b([A-Z][a-z]{2,})-(\d{1,5})\b/.freeze

# Prefix words that make a token prose rather than a surname. Extend this rather
# than loosening the regex — a false positive here costs a moment, a false
# NEGATIVE ships an ancestor.
WIKITREE_PROSE_PREFIXES = %w[
  Pre Post Gen Generation Phase Recipe Round Tier Step Rule Spec Item Task Type
  Note Prompt Line Page Part Iter Option Level Wave Batch Run Set Surname Table
  Figure Section Appendix Version Draft Sample Example Fixture Case
].freeze

def wikitree_placeholder?(prefix)
  WIKITREE_PROSE_PREFIXES.include?(prefix)
end

# A token is a placeholder when its two halves are each a single repeated
# character (XXXX-XXX, AAAA-AAA), or when it is one of the deliberate stand-ins
# used in examples and fixtures.
PLACEHOLDER_IDENTIFIERS = %w[ABCD-123 EFGH-4JK].freeze

def placeholder_identifier?(token)
  return true if PLACEHOLDER_IDENTIFIERS.include?(token)

  left, right = token.split("-")
  left.chars.uniq.length == 1 && right.chars.uniq.length == 1
end

# --- Vault person ids -------------------------------------------------------
#
# ADDED 25 AUG 2026, AFTER THIS SCRIPT PASSED THE THING IT EXISTS TO CATCH. A real
# person's forename, surname and vault id sat in a `person_store.py` docstring as
# the worked example explaining a ruling, and every audit run over it said PASS.
# Two blind spots met: the name was COLLATERAL, so it is not among the denylist's
# core surnames, and a vault `P-` id is neither of the identifier shapes above. The
# combination the method rule warns about -- a name beside its vault id -- was the
# one combination nothing checked. Caught by a manual pre-push review, again.
#
# WHY THE OTHER TWO CHECKS' APPROACH DOES NOT WORK HERE. A vault id carries no
# structure that separates a real one from a fixture: `P-DATE01`, `P-TST001` and
# `P-BANKED` are as valid as any minted id, and the tracked tree holds 121 such
# stand-ins against 8 real ones. Repeated-character and Crockford tests were both
# measured and both fail -- a mnemonic fixture is Crockford-valid.
#
# SO THIS CHECK ASKS THE VAULT. When one is reachable it reads the ids that
# actually name a person and flags only those, which on 25 AUG 2026 separated the
# 8 real from the 121 fixtures with no false positives in either direction.
#
# ⚠ AND IT SAYS SO WHEN IT CANNOT. On a bare clone with no vault there is nothing
# to resolve against, and the report records the check as SKIPPED rather than
# printing None -- a silent pass and a real pass must not look alike, which is the
# rule this whole file is an instance of.
VAULT_ID_RE = /\bP-[0-9A-Z]{6}\b/.freeze

# Real ids ALREADY PUBLIC in this repo's history, measured 25 AUG 2026. They are
# bare pointers with no name attached, they shipped in earlier pushes, and
# rewriting long-public history to remove them would be a larger harm than the
# disclosure -- the same trade the HEAD-ONLY note above makes. Listing them keeps
# the check at ZERO findings, which is the bar every check here is held to.
# ⛔ Do not add to this list to silence a NEW finding. That is the whole gate.
PUBLISHED_VAULT_IDS = %w[
  P-BAH7B0 P-BEAZEM P-G4C4Z5 P-JFB426 P-MT0TCC P-PZ4YD2 P-QA1VKV P-SAMSYV
].freeze

# The vault is per-install and never inside this repo's tracked tree: honour
# AUTORESEARCH_VAULT, else accept a single sibling directory carrying the
# `.autoresearch.json` marker. Two candidates is not a guess worth making.
# Returns [dir, source]; the source is printed, so a fallback is never silent.
def vault_dir
  env = ENV["AUTORESEARCH_VAULT"].to_s
  return [env, "AUTORESEARCH_VAULT"] if !env.empty? && File.file?(File.join(env, ".autoresearch.json"))

  candidates = Dir.glob(File.join(ROOT, "*")).select do |dir|
    File.directory?(dir) && File.file?(File.join(dir, ".autoresearch.json"))
  end
  return [nil, nil] unless candidates.length == 1

  why = env.empty? ? "AUTORESEARCH_VAULT unset" : "AUTORESEARCH_VAULT is not a vault"
  [candidates.first, "sibling fallback, #{why}"]
end

# ⛔⛔ THE ID READER MUST NOT BE ABLE TO RETURN ZERO QUIETLY (13 SEP 2026). It was one
# regex, `\{id: (P-...)` over `Family_Tree*.md`, and it resolved nothing -- while the
# result still read PASS -- in two ordinary cases: a vault on the `file` person model
# (the framework DEFAULT, whose ids live in per-person frontmatter), and a meta line
# whose `id` key is not written first, which is valid YAML and which person_store
# parses. An empty id set is not nil, so neither case fell into SKIPPED either: the
# report said "resolved against 0 person ids" and passed. Correct on this vault only
# because every meta line happens to lead with `{id: `.
#
# So the reader follows the vault's declared model and does not care about key
# order, and `vault_id_state` refuses to pass on zero without an independent witness.
META_LINE_RE = /^\s*-\s*meta:\s*\{/.freeze
META_ID_RE = /(?:\{|,)\s*id:\s*['"]?(P-[0-9A-Z]{6})\b/.freeze
FRONTMATTER_ID_RE = /^id:\s*['"]?(P-[0-9A-Z]{6})\b/.freeze
FRONTMATTER_PERSON_RE = /^type:\s*['"]?person['"]?\s*$/.freeze

# person_store's `_iter_person_files`: every `*.md` except `templates/` scaffolding.
def vault_markdown(dir)
  Dir.glob(File.join(dir, "**", "*.md")).reject do |path|
    path.sub(dir, "").split(File::SEPARATOR).include?("templates")
  end
end

# The vault's person model, as vault_config.get_person_model reads it: `file` when
# the key is absent, nil (unreadable) for a bad config or an unknown value -- which
# Python treats as a hard error, and so does this.
def person_model(dir)
  cfg = JSON.parse(read_text(File.join(dir, ".autoresearch.json")))
  model = cfg.is_a?(Hash) ? (cfg["person_model"] || "file") : nil
  %w[file narrative].include?(model) ? model : nil
rescue JSON::ParserError
  nil
end

# { ids: {id => true}, records: n } -- `records` counts person records seen, with or
# without a readable id, so a partial miss is visible in the report.
def vault_person_ids(dir, model)
  ids = {}
  records = 0
  if model == "narrative"
    Dir.glob(File.join(dir, "Family_Tree*.md")).each do |path|
      read_text(path).each_line do |line|
        next unless line.match?(META_LINE_RE)

        records += 1
        match = line.match(META_ID_RE)
        ids[match[1]] = true if match
      end
    end
  else
    vault_markdown(dir).each do |path|
      text = read_text(path)
      next unless text.start_with?("---")

      front = text.split(/^---[ \t]*$/, 3)[1]
      next unless front&.match?(FRONTMATTER_PERSON_RE)

      records += 1
      match = front.match(FRONTMATTER_ID_RE)
      ids[match[1]] = true if match
    end
  end
  { ids: ids, records: records }
end

# The report line for a reachable vault. Starts with "BLIND" when the reader cannot
# have seen the vault's ids, which FAILS the audit: a vault is present, so this is
# not the bare-clone SKIPPED case -- it is the instrument reporting on nothing.
def vault_id_state(dir, source, model, read)
  where = "#{File.basename(dir)} (#{source})"
  return "BLIND -- #{where}: .autoresearch.json has no readable person_model" if model.nil?

  ids = read[:ids]
  if ids.empty?
    # ⭐ THE WITNESS IS DELIBERATELY NOT THE READER'S GRAMMAR. Any `P-` + six token in
    # the vault's Markdown means people exist that the reader failed to see; only a
    # vault with no such token at all is honestly empty.
    witness = vault_markdown(dir).find { |path| read_text(path).match?(VAULT_ID_RE) }
    if witness
      return "BLIND -- #{where}: the #{model}-model reader resolved 0 person ids, but " \
             "#{witness.sub("#{dir}/", "")} holds P- id tokens. Not a pass: nothing was resolved."
    end
    return "resolved against 0 person ids in #{where}; the vault holds no P- ids"
  end

  state = "resolved against #{ids.length} person ids in #{where}, #{model} model"
  missing = read[:records] - ids.length
  state += "; ⚠ #{missing} person record(s) had no readable id" if missing.positive?
  state
end

def vault_id_findings(vault_ids)
  return [] if vault_ids.nil?

  findings = []
  tracked_text_files.each do |path|
    next if EXCLUDED_PATHS.include?(path)

    read_text(File.join(ROOT, path)).lines.each_with_index do |line, index|
      line.scan(VAULT_ID_RE).uniq.each do |token|
        next unless vault_ids.key?(token)
        next if PUBLISHED_VAULT_IDS.include?(token)

        findings << { path: path, line: index + 1, token_label: term_label(token) }
      end
    end
  end
  findings
end

def identifier_findings
  findings = []
  tracked_text_files.each do |path|
    next if EXCLUDED_PATHS.include?(path)

    read_text(File.join(ROOT, path)).lines.each_with_index do |line, index|
      line.scan(IDENTIFIER_RE).uniq.each do |token|
        next if placeholder_identifier?(token)

        findings << { path: path, line: index + 1, token_label: term_label(token) }
      end

      line.scan(WIKITREE_RE).uniq.each do |prefix, number|
        next if wikitree_placeholder?(prefix)

        findings << { path: path, line: index + 1,
                      token_label: term_label("#{prefix}-#{number}") }
      end
    end
  end
  findings
end

def write_report(terms, head_findings, git_history_findings, id_findings,
                 vault_id_findings, vault_state)
  FileUtils.mkdir_p(REPORT_DIR)
  timestamp = Time.now.utc.strftime("%Y-%m-%d-%H%M%S")
  path = File.join(REPORT_DIR, "#{timestamp}.md")

  head_sha, = run_git("rev-parse", "HEAD")
  log_count, = run_git("rev-list", "--count", "HEAD")

  content = +"# Privacy Audit\n\n"
  content << "- Generated: #{Time.now.utc.iso8601}\n"
  content << "- HEAD: `#{head_sha.strip}`\n"
  content << "- Reachable commits on current branch: #{log_count.strip}\n"
  content << "- Denylist terms checked: #{terms.length}\n"
  content << "- Excluded paths: #{EXCLUDED_PATHS.join(', ')}\n"
  content << "- Identifier shapes checked: FamilySearch PID + WikiTree id (HEAD only)\n"
  content << "- Vault person ids (`P-` + six): #{vault_state}\n\n"

  content << "## Current HEAD Findings\n\n"
  if head_findings.empty?
    content << "None.\n\n"
  else
    head_findings.each do |finding|
      content << "- `#{finding[:term_label]}` in `#{finding[:path]}` lines #{finding[:lines].join(', ')}\n"
    end
    content << "\n"
  end

  content << "## Reachable History Findings\n\n"
  if git_history_findings.empty?
    content << "None.\n\n"
  else
    git_history_findings.each do |finding|
      if finding[:error]
        content << "- `#{finding[:term_label]}`: #{finding[:error]}\n"
      else
        content << "- `#{finding[:term_label]}` appears in commits:\n"
        finding[:commits].each { |commit| content << "  - #{commit}\n" }
      end
    end
    content << "\n"
  end

  content << "## Identifier Findings (HEAD only)\n\n"
  content << "Record-identifier shapes that are not recognised placeholders. An external\n"
  content << "id is a pointer to a NAME, so it discloses a person even though no denylist\n"
  content << "term appears. See the note above IDENTIFIER_RE for what is and is not scanned.\n\n"
  if id_findings.empty?
    content << "None.\n\n"
  else
    id_findings.each do |finding|
      content << "- `#{finding[:token_label]}` in `#{finding[:path]}` line #{finding[:line]}\n"
    end
    content << "\n"
  end

  content << "## Vault Person-Id Findings (HEAD only)\n\n"
  content << "Ids that resolve to a real person in the reachable vault. A vault id is a\n"
  content << "pointer to a NAME in the same way an external record id is, and the worked\n"
  content << "example that explains a script is where one crosses into this repo.\n\n"
  if vault_state.start_with?("skipped")
    content << "SKIPPED -- #{vault_state}. Not a pass: nothing was resolved.\n\n"
  elsif vault_state.start_with?("BLIND")
    content << "#{vault_state}\n\n"
  elsif vault_id_findings.empty?
    content << "None.\n\n"
  else
    vault_id_findings.each do |finding|
      content << "- `#{finding[:token_label]}` in `#{finding[:path]}` line #{finding[:line]}\n"
    end
    content << "\n"
  end

  content << "## Result\n\n"
  content << if head_findings.empty? && git_history_findings.empty? && id_findings.empty? &&
                vault_id_findings.empty? && !vault_state.start_with?("BLIND")
               "PASS\n"
             else
               "FAIL\n"
             end

  File.write(path, content)
  path
end

terms = load_terms
head_findings = current_head_findings(terms)
git_history_findings = history_findings(terms)
id_findings = identifier_findings

dir, source = vault_dir
if dir
  model = person_model(dir)
  read = model ? vault_person_ids(dir, model) : { ids: {}, records: 0 }
  vault_findings = vault_id_findings(read[:ids])
  vault_state = vault_id_state(dir, source, model, read)
else
  vault_findings = []
  vault_state = "skipped, no reachable vault (set AUTORESEARCH_VAULT to enable)"
end
vault_blind = vault_state.start_with?("BLIND")

report_path = write_report(terms, head_findings, git_history_findings, id_findings,
                           vault_findings, vault_state)

if head_findings.empty? && git_history_findings.empty? && id_findings.empty? &&
   vault_findings.empty? && !vault_blind
  puts "privacy-audit-repo: ok"
  puts "report: #{report_path}"
else
  groups = head_findings.length + git_history_findings.length + id_findings.length +
           vault_findings.length
  warn "privacy-audit-repo: #{groups} finding group(s)"
  warn "privacy-audit-repo: vault person-id check #{vault_state}" if vault_blind
  warn "report: #{report_path}"
  exit 1
end
